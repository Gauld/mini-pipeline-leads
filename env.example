# Copia este archivo a .env.local y rellena los valores.
# Reinicia `next dev` después de cambiarlo (Next solo lee las variables al arrancar).
# En Vercel: Project Settings > Environment Variables.

# ── OBLIGATORIAS ──────────────────────────────────────────────

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave que cifra la contraseña SMTP guardada en la base de datos (AES-256-GCM).
# 32 bytes en base64. Genérala con:  openssl rand -base64 32
# Sin ella no se puede guardar la configuración de email ni enviar correos.
# Si la pierdes o la cambias, hay que volver a introducir la contraseña en la app.
SETTINGS_ENCRYPTION_KEY=

# Automatización "sistema" (email de bienvenida al registrarse un lead).
# SERVICE ROLE: ignora RLS. Solo servidor, NUNCA con prefijo NEXT_PUBLIC_. (Project Settings > API)
SUPABASE_SERVICE_ROLE_KEY=
# Secreto compartido entre el trigger de la BD y /api/automation/lead-created.
# Genéralo con:  openssl rand -base64 32
# El mismo valor se guarda en private.automation_config (ver supabase/schema.sql, sección 3d).
AUTOMATION_SECRET=

# Antiabuso del formulario público.
# Sal para hashear IP y email en los contadores de rate limit. Genérala con:  openssl rand -base64 32
# En producción es OBLIGATORIA (sin ella el formulario rechaza los envíos).
RATE_LIMIT_SALT=
# Cloudflare Turnstile (dash.cloudflare.com > Turnstile > Add widget; gratis).
# Site key = pública; secret key = solo servidor. En producción, sin secret key se rechazan los envíos.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Tope diario de emails de bienvenida (por defecto 200). Superado, quedan pendientes.
# WELCOME_EMAIL_DAILY_CAP=200

# Solo desarrollo: permite un SMTP local/interno (p. ej. Mailpit en localhost:1025).
# Se IGNORA en producción. Por defecto el servidor solo conecta a SMTP públicos en 25/465/587/2525.
# SMTP_ALLOW_INTERNAL=true

# ── OPCIONALES: respaldo de email ─────────────────────────────

# La cuenta de correo se configura en la app (Panel > Configuración de email) y se
# guarda en la tabla email_settings. Las variables SMTP_* / EMAIL_* solo se usan
# como respaldo si NO hay configuración guardada.
# Gmail: smtp.gmail.com, puerto 465 y una "contraseña de aplicación"
# (requiere verificación en 2 pasos: https://myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=true          # por defecto true si el puerto es 465
# EMAIL_FROM=               # por defecto SMTP_USER (el proveedor debe permitirlo)
# EMAIL_FROM_NAME=Academia  # nombre visible del remitente
